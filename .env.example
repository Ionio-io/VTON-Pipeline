# ── fal.ai API key ──────────────────────────────────────────────────────────
# Required for: generate_models.py, tryon_samples.py, print_fidelity_test.py,
#               sophisticated_print_test.py
# Get your key: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# ── OpenRouter API key ───────────────────────────────────────────────────────
# Required for: classify_products.py
# Get your key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ── Replicate API token ──────────────────────────────────────────────────────
# Required for: swapper_model_test/swapper_replicate_test.py
# Get your token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# ── Hugging Face token (optional) ───────────────────────────────────────────
# Required only if your HF Space is private
# Get your token: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
